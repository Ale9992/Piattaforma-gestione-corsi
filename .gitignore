# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database locale e backup
/data
/backups
*.db
*.db-wal
*.db-shm

# env (mantieni solo l'esempio)
!.env.example

# materiale di lavoro e impostazioni locali (mai nel repo)
/Lezioni*
/.claude
/scripts/deploy.config

# test: restano in locale, fuori dal repo
**/__tests__/
*.test.ts
*.test.tsx
/scripts/smoke.mjs

# istruzioni per gli strumenti di sviluppo locali
/CLAUDE.md
/AGENTS.md
