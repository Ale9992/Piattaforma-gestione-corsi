# --- Chi assegna i corsi (opzionale) ---
# Nome dell'agenzia o della società che manda gli incarichi: compare sotto il
# titolo e nei testi ("slot liberi da comunicare a ..."). Vuoto = non si mostra.
AGENCY_NAME=
# I modi in cui l'agenzia si nomina nelle sue mail, separati da virgola: nome,
# abbreviazioni, domini. Servono a non confonderla col cliente del corso, perché
# nelle mail compare in ogni oggetto ("Annullamento lezione 13/10 Rossi - ...").
# Se vuoto si usa AGENCY_NAME.
AGENCY_ALIASES=

# Database SQLite. Il prefisso "file:" è opzionale; percorsi relativi alla cartella del progetto.
# In Docker viene forzato a file:/data/app.db (volume persistente ./data).
DATABASE_URL=file:./data/app.db

# Chiave API DeepSeek: usata SOLO lato server per estrarre i dati dalla mail di un nuovo corso.
# Se vuota il parser è disabilitato e i corsi si inseriscono manualmente.
DEEPSEEK_API_KEY=

# Opzionali
# Modelli disponibili: deepseek-flash (default) e deepseek-v4-pro.
# Gli alias deepseek-chat e deepseek-reasoner sono stati ritirati e non funzionano più.
# DEEPSEEK_MODEL=deepseek-flash
# Ragionamento del modello: none (default) | minimal | low | high | max
# DEEPSEEK_REASONING_EFFORT=none
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Solo docker compose: porta e interfaccia di ascolto sull'host
# APP_PORT=3000
# APP_BIND=0.0.0.0

# --- Sincronizzazione con Apple Calendar (opzionale) ---
# Apple ID e password per app (appleid.apple.com → Accesso e sicurezza → Password per app).
# Richiede l'autenticazione a due fattori. Se vuote, la sincronizzazione è disattivata.
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
# Nome del calendario su cui scrivere, esattamente come appare in Apple Calendar
# (per esempio "Lavoro"). Il gestionale tocca solo gli eventi che ha creato lui.
ICLOUD_CALENDAR_NAME=

# --- Posta: lettura delle mail di incarico (sola lettura) ---
# Casella IMAP da cui leggere gli incarichi, con una password per app.
# Nota: le caselle Outlook personali non accettano più le password per app
# (Microsoft le ha disattivate il 16/09/2024) e l'accesso OAuth2 richiede di
# registrare un'app. Il giro più semplice è inoltrare le mail a una casella
# Gmail e leggere quella.
MAIL_USER=
MAIL_APP_PASSWORD=

# Mittenti da seguire, separati da virgola: si leggono solo le mail che arrivano
# da questi indirizzi. Si accettano interi domini, con la chiocciola davanti, e
# il mittente viene riconosciuto anche dietro un inoltro.
# Esempio: MAIL_SENDERS=incarichi@agenzia.it,@agenzia-formazione.it
MAIL_SENDERS=

# Opzionali: server, cartella e intervallo del controllo periodico.
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_IMAP_PORT=993
MAIL_FOLDER=INBOX
# MAIL_POLL_MINUTES=10

# Se un domani registri l'app su Entra, la lettura diretta da Outlook si
# riattiva mettendo qui l'ID applicazione (client) e lanciando npm run posta:accedi.
# OUTLOOK_EMAIL=
# OUTLOOK_CLIENT_ID=
